# systemd unit — Docker를 쓰지 않고 라즈베리파이에 직접 설치할 때 사용합니다.
# (32-bit 라즈베리파이 OS처럼 pandas 휠이 없는 환경에서는 이 방법이 낫습니다)
#
# 설치:
#   # uv 설치 (없다면)
#   curl -LsSf https://astral.sh/uv/install.sh | sudo env UV_INSTALL_DIR=/usr/local/bin sh
#   sudo useradd -r -s /usr/sbin/nologin tqt || true
#   sudo mkdir -p /opt/tqt && sudo chown tqt:tqt /opt/tqt
#   sudo -u tqt git clone https://github.com/aquariusmin/toss-api-quant-trading /opt/tqt/app
#   cd /opt/tqt/app
#   sudo -u tqt uv sync --locked          # .venv 생성 (uv.lock 그대로 설치)
#   sudo -u tqt cp .env.example .env && sudo -u tqt vi .env
#   sudo cp deploy/tqt.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tqt
#
# 확인:  journalctl -u tqt -f
# 정지:  sudo systemctl stop tqt     (또는 텔레그램에서 /halt)

[Unit]
Description=tqt — Toss Securities quant trading bot
Documentation=https://github.com/aquariusmin/toss-api-quant-trading
# 시세·주문 모두 네트워크가 필요하므로 온라인 상태를 기다립니다.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tqt
Group=tqt
WorkingDirectory=/opt/tqt/app
Environment=TZ=Asia/Seoul
Environment=PYTHONUNBUFFERED=1
Environment=UV_PROJECT_ENVIRONMENT=/opt/tqt/app/.venv
EnvironmentFile=/opt/tqt/app/.env

# 시작 전 lockfile 기준으로 동기화. 앞의 '-' 는 네트워크가 없을 때도 기존
# .venv 로 그냥 뜨게 합니다 — 부팅 시 인터넷이 늦게 올라오는 라즈베리파이에서
# 봇이 아예 안 뜨는 것보다 낫습니다.
ExecStartPre=-/usr/local/bin/uv sync --locked
# --no-sync: 위에서 이미 동기화했으므로 실행 시점에 다시 네트워크를 타지 않습니다.
ExecStart=/usr/local/bin/uv run --no-sync tqt run --dashboard

# 재시작 정책: 죽으면 30초 뒤 다시 띄웁니다. 봇이 조용히 멈춘 채 방치되는 것이
# 가장 위험한 상태이므로 항상 되살립니다.
Restart=always
RestartSec=30
# 5분 안에 5번 넘게 죽으면 포기하고 멈춥니다(무한 재시작 루프 방지).
StartLimitIntervalSec=300
StartLimitBurst=5

# 종료 시 스케줄러가 정리할 시간을 줍니다.
KillSignal=SIGINT
TimeoutStopSec=30

# --- 하드닝 -----------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# DB, 로그, 그리고 uv 가 관리하는 .venv 를 쓸 수 있어야 합니다.
# (ProtectSystem=strict 아래에서는 여기 없는 경로가 전부 읽기 전용입니다)
ReadWritePaths=/opt/tqt/app
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryMax=1G

# --- 로깅 -------------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tqt

[Install]
WantedBy=multi-user.target
