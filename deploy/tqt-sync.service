# 시세 데이터 일일 갱신 (tqt-sync.timer 가 호출합니다).
[Unit]
Description=tqt — daily market data sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tqt
Group=tqt
WorkingDirectory=/opt/tqt/app
Environment=TZ=Asia/Seoul
Environment=UV_PROJECT_ENVIRONMENT=/opt/tqt/app/.venv
EnvironmentFile=/opt/tqt/app/.env
ExecStart=/usr/local/bin/uv run --no-sync tqt data sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tqt/app
SyslogIdentifier=tqt-sync
