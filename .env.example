# ===========================================================================
# toss-api-quant-trading — environment template
# Copy to `.env` and fill in. NEVER commit `.env` (it is gitignored).
# ===========================================================================

# --- Toss Securities Open API ----------------------------------------------
# Issue from: Toss WTS -> 설정 -> Open API
# Then register your server's public IP under "허용 IP 관리",
# otherwise every call returns 403 edge-blocked.
toss_client_id=
toss_client_secret=

# Your brokerage account number (종합매매 계좌번호), digits only or with dashes.
# Used to resolve the numeric `accountSeq` that the API actually wants for the
# X-Tossinvest-Account header. Leave TOSS_ACCOUNT_SEQ empty to auto-resolve.
toss_bank_account=
TOSS_ACCOUNT_SEQ=

# --- Run mode --------------------------------------------------------------
# backtest | paper | live
# `live` sends real orders with real money. It additionally requires
# TQT_LIVE_CONFIRM below to be set to the exact string I_UNDERSTAND_REAL_MONEY.
TQT_MODE=paper
TQT_LIVE_CONFIRM=

# --- Risk limits (see src/tqt/risk.py) -------------------------------------
TQT_MAX_POSITION_WEIGHT=0.20      # max fraction of equity in one symbol
TQT_MAX_DAILY_LOSS_PCT=0.03       # halt trading for the day past -3%
TQT_MAX_ORDERS_PER_DAY=40
TQT_MAX_GROSS_EXPOSURE=1.00       # 1.00 = no leverage, no margin
TQT_PAPER_STARTING_CASH_KRW=1000000

# --- Notifications ---------------------------------------------------------
# Telegram: create a bot with @BotFather, then message it once and read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# --- Dashboard -------------------------------------------------------------
TQT_DASHBOARD_HOST=0.0.0.0
TQT_DASHBOARD_PORT=8000
# Required to open the dashboard. Generate with: openssl rand -hex 24
TQT_DASHBOARD_TOKEN=

# --- Storage ---------------------------------------------------------------
TQT_DB_PATH=data/tqt.db
TQT_LOG_LEVEL=INFO
